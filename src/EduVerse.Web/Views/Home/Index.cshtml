@{
    ViewData["Title"] = "Dashboard";
}
<div class="mb-4">
  <p class="ev-eyebrow mb-2">EduVerse platform</p>
  <h1 class="display-6 fw-semibold">Institution command center</h1>
  <p class="text-secondary">One portal, independently deployable modules and API-owned business logic.</p>
</div>
@if (User.IsInRole("PLATFORM_SUPER_ADMIN"))
{
  <section class="ev-card p-4 mb-4">
    <h2 class="h4">Platform administration</h2>
    <p>Review institution registrations and control school onboarding.</p>
    <a href="/platform/registrations" class="btn btn-primary">Review pending schools</a>
  </section>
}
else if (User.IsInRole("ADMIN"))
{
  <section class="mb-4">
    <h2 id="institution-name" class="h4">Loading institution…</h2>
    <p id="institution-plan" class="text-secondary">Checking subscription…</p>
    <p><a class="btn btn-outline-primary btn-sm" href="/portal/learning-review">Review learning content</a></p>
    <div class="row g-3" id="tenant-module-cards" aria-live="polite">
      <div class="col-12"><p>Loading school or college modules…</p></div>
    </div>
  </section>
}
else if (User.Identity?.IsAuthenticated == true)
{
  <section class="ev-card p-4 mb-4">
    <h2 class="h4">Your EduVerse workspace</h2>
    <p class="text-secondary">Choose the portal assigned to you by your institution. The API will verify your role, class and linked student records.</p>
    <div class="d-flex flex-wrap gap-2">
      <a href="/portal/teacher" class="btn btn-primary">Teacher</a>
      <a href="/portal/parent" class="btn btn-outline-primary">Parent</a>
      <a href="/portal/student" class="btn btn-outline-primary">Student</a>
    </div>
  </section>
}
else
{
  <section class="ev-card p-4 mb-4">
    <h2 class="h4">Welcome to EduVerse</h2>
    <p>Register your school, or sign in with an approved institution administrator account.</p>
    <a class="btn btn-primary" href="/account/login">Sign in</a>
    <a class="btn btn-outline-primary" href="/register-institution">Register school</a>
  </section>
}
<section class="ev-card p-4">
  <h2 class="h5">Core API status</h2>
  <p id="api-status" role="status" aria-live="polite" class="mb-0">Checking REST API…</p>
</section>
