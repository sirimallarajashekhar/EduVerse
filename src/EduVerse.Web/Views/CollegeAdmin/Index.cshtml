@{ViewData["Title"]="Advanced College";}
<p class="ev-eyebrow">EduVerse · Higher education</p>
<h1 class="h3">Advanced College Management</h1>
<p class="text-secondary">Credit-based degree programs, semesters, course enrollment, published exam grades and academic progression. All rules are enforced by the API.</p>
<section class="ev-card p-4 mb-3">
 @Html.AntiForgeryToken()
 <label for="campus" class="form-label">Campus</label><select id="campus" class="form-select" style="max-width:440px"></select>
 <p id="status" role="status" class="small mt-2"></p><p id="metrics" class="small text-secondary"></p>
</section>
<div class="row g-3 mb-3">
 <div class="col-lg-5"><section class="ev-card p-4 h-100">
  <h2 class="h5">Academic regulations</h2>
  <form id="regulation-form" class="row g-2">
   <div class="col-sm-4"><label for="rule-code" class="form-label">Code</label><input id="rule-code" maxlength="30" class="form-control" required/></div>
   <div class="col-sm-8"><label for="rule-name" class="form-label">Name</label><input id="rule-name" maxlength="160" class="form-control" required/></div>
   <div class="col-sm-6"><label for="passing" class="form-label">Passing grade points</label><input id="passing" type="number" min="0" max="10" step=".01" class="form-control" value="4" required/></div>
   <div class="col-sm-6"><label for="minimum" class="form-label">Credits for progression</label><input id="minimum" type="number" min="0" max="200" step=".01" class="form-control" value="0" required/></div>
   <div class="col-sm-6"><label for="max-semesters" class="form-label">Maximum semesters</label><input id="max-semesters" type="number" min="2" max="16" class="form-control" value="8" required/></div>
   <div class="col-sm-6 d-flex align-items-end"><label><input id="allow-backlogs" type="checkbox"/> Allow backlog progression</label></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Create regulation</button></div>
  </form><ul id="regulations" class="small mt-3"></ul>
 </section></div>
 <div class="col-lg-7"><section class="ev-card p-4 h-100">
  <h2 class="h5">Degree programs</h2>
  <form id="program-form" class="row g-2">
   <div class="col-sm-6"><label for="catalog-program" class="form-label">Academic catalog program</label><select id="catalog-program" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="program-rule" class="form-label">Regulation</label><select id="program-rule" class="form-select" required></select></div>
   <div class="col-sm-5"><label for="program-code" class="form-label">Code</label><input id="program-code" maxlength="30" class="form-control" required/></div>
   <div class="col-sm-7"><label for="program-name" class="form-label">Program name</label><input id="program-name" maxlength="160" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-primary" type="submit">Register degree program</button></div>
  </form><ul id="programs" class="small mt-3"></ul>
 </section></div>
</div>
<div class="row g-3 mb-3">
 <div class="col-lg-5"><section class="ev-card p-4 h-100">
  <h2 class="h5">Semester registration</h2>
  <form id="semester-form" class="row g-2">
   <div class="col-sm-6"><label for="sem-program" class="form-label">Degree program</label><select id="sem-program" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="sem-year" class="form-label">Academic year</label><select id="sem-year" class="form-select" required></select></div>
   <div class="col-sm-8"><label for="sem-catalog" class="form-label">Catalog semester</label><select id="sem-catalog" class="form-select" required></select></div>
   <div class="col-sm-4"><label for="sem-number" class="form-label">Semester no.</label><input id="sem-number" type="number" min="1" max="16" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Create semester</button></div>
  </form><ul id="semesters" class="small mt-3"></ul>
 </section></div>
 <div class="col-lg-7"><section class="ev-card p-4 h-100">
  <h2 class="h5">Core and elective course offerings</h2>
  <form id="course-form" class="row g-2">
   <div class="col-sm-6"><label for="course-program" class="form-label">Program</label><select id="course-program" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="course-semester" class="form-label">Semester</label><select id="course-semester" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="course-subject" class="form-label">Academic subject</label><select id="course-subject" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="course-pre" class="form-label">Prerequisite (optional)</label><select id="course-pre" class="form-select"></select></div>
   <div class="col-sm-4"><label for="course-code" class="form-label">Course code</label><input id="course-code" maxlength="30" class="form-control" required/></div>
   <div class="col-sm-8"><label for="course-title" class="form-label">Course title</label><input id="course-title" maxlength="160" class="form-control" required/></div>
   <div class="col-sm-4"><label for="course-type" class="form-label">Type</label><select id="course-type" class="form-select"><option>CORE</option><option>ELECTIVE</option></select></div>
   <div class="col-sm-4"><label for="course-credits" class="form-label">Credits</label><input id="course-credits" type="number" step=".01" min=".01" max="30" class="form-control" required/></div>
   <div class="col-sm-4"><label for="course-capacity" class="form-label">Seats</label><input id="course-capacity" type="number" min="1" max="5000" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-primary" type="submit">Add course</button></div>
  </form><ul id="courses" class="small mt-3"></ul>
 </section></div>
</div>
<section class="ev-card p-4 mb-3">
 <h2 class="h5">Student course registration, grades and progression</h2>
 <div class="row g-3">
  <div class="col-lg-5">
   <label for="enrollment" class="form-label">College enrollment</label>
   <select id="enrollment" class="form-select"></select>
   <form id="registration-form" class="row g-2 mt-2">
    <div class="col-12"><label for="register-course" class="form-label">Course offering</label><select id="register-course" class="form-select" required></select></div>
    <div class="col-12"><button class="btn btn-outline-primary" type="submit">Enroll in course</button></div>
   </form>
   <form id="finalize-form" class="row g-2 mt-3">
    <div class="col-12"><label for="finalize-semester" class="form-label">Semester to finalize</label><select id="finalize-semester" class="form-select" required></select></div>
    <div class="col-12"><button class="btn btn-primary" type="submit">Finalize semester results</button></div>
   </form>
  </div>
  <div class="col-lg-7">
   <h3 class="h6">Course registrations</h3><ul id="registrations" class="small"></ul>
   <h3 class="h6 mt-3">Credit-weighted transcript</h3><p id="transcript" class="small text-secondary"></p>
   <ul id="term-results" class="small"></ul>
  </div>
 </div>
</section>
@section Scripts {<script src="~/js/college-admin.js" asp-append-version="true"></script>}
