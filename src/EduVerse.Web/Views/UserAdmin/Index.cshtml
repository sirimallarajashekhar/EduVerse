@{ ViewData["Title"] = "User Management"; }
@{ ViewData["Title"] = ViewData["ActivityTitle"]; }
<div class="ev-module-workspace" data-activity-page="true" data-activity-base="/admin/users">
<div class="mb-4">
  <p class="ev-eyebrow">Identity administration</p>
  <h1 class="h2">@ViewData["ActivityTitle"]</h1><p><a class="ev-module-home" href="/admin/users">← All user activities</a></p>

@Html.AntiForgeryToken()

  <a class="btn btn-outline-primary mt-2" href="/admin/rbac">Manage custom roles &amp; permissions</a>
  <p class="text-secondary">Invite staff and manage who can use your institution workspace.</p>
</div>
<div ev-activities="invite-form" class="ev-card p-4 mb-4">

  <form ev-activities="invite-form" data-ev-action="Invite" data-ev-action-key="invite-form" id="invite-form" class="row g-3">
    @Html.AntiForgeryToken()
    <div class="col-md-4"><label class="form-label" for="email">Email</label>
      <input id="email" name="email" type="email" class="form-control" required /></div>
    <div class="col-md-4"><label class="form-label" for="displayName">Name</label>
      <input id="displayName" name="displayName" class="form-control" required /></div>
    <div class="col-md-2"><label class="form-label" for="roleCode">Role</label>
      <select id="roleCode" class="form-select"><option value="MEMBER">Member</option><option value="ADMIN">Admin</option></select></div>
    <div class="col-md-2 d-flex align-items-end"><button type="submit" class="btn btn-primary w-100">Invite</button></div>
  </form>
  <p id="invite-message" role="status" class="small mt-3 mb-0"></p>
</div>
<div ev-activities="user-rows" class="ev-card p-4">

  <div ev-activities="user-rows" data-ev-action="View Active users" data-ev-action-key="user-rows" id="ev-action-user-rows" class="table-responsive">
    <table class="table table-striped align-middle">
      <thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Action</th></tr></thead>
      <tbody id="user-rows"><tr><td colspan="3">Loading…</td></tr></tbody>
    </table>
  </div>
</div>

@section Scripts { <script src="~/js/user-admin.js" asp-append-version="true"></script> }

</div>
