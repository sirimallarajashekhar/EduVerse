{
  "Api": { "BaseUrl": "http://localhost:5201/" },
  "ReverseProxy": {
    "Routes": {
      "ams-root": { "ClusterId": "ams", "Match": { "Path": "/ams" } },
      "ams-pages": { "ClusterId": "ams", "Match": { "Path": "/ams/{**remainder}" } },
      "hrms-root": { "ClusterId": "hrms", "Match": { "Path": "/hrms" } },
      "hrms-pages": { "ClusterId": "hrms", "Match": { "Path": "/hrms/{**remainder}" } }
    },
    "Clusters": {
      "ams": { "Destinations": { "primary": { "Address": "http://localhost:5202/" } } },
      "hrms": { "Destinations": { "primary": { "Address": "http://localhost:5203/" } } }
    }
  },
  "Logging": { "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" } },
  "AllowedHosts": "*"
}
