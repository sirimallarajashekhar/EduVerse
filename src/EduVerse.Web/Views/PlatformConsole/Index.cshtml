@{ViewData["Title"]="Platform Super Admin console";}
<header class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
 <div><p class="ev-eyebrow mb-1">EduVerse · Platform Super Admin</p><h1 class="h3">Platform control center</h1>
 <p class="text-secondary mb-0">Central oversight of all institutions, modules, users and approvals.</p></div>
 <div class="d-flex gap-2"><a href="/platform/registrations" class="btn btn-primary">Institution approvals</a>
 <form method="post" action="/platform/logout">@Html.AntiForgeryToken()
  <button class="btn btn-outline-secondary" type="submit">Sign out</button></form></div>
</header>
<form id="platform-token">@Html.AntiForgeryToken()</form>
<div class="row g-3 mb-3">
 <div class="col-md-4"><section class="ev-card p-3"><p class="text-secondary mb-1">Institutions</p><h2 id="platform-total" class="h3">—</h2></section></div>
 <div class="col-md-4"><section class="ev-card p-3"><p class="text-secondary mb-1">Active institutions</p><h2 id="platform-active" class="h3">—</h2></section></div>
 <div class="col-md-4"><section class="ev-card p-3"><p class="text-secondary mb-1">Active memberships</p><h2 id="platform-members" class="h3">—</h2></section></div>
</div>
<section class="ev-card p-4 mb-3">
 <div class="d-flex flex-wrap justify-content-between gap-2"><h2 class="h5">All institutions</h2>
 <button class="btn btn-outline-primary btn-sm" id="platform-refresh" type="button">Refresh</button></div>
 <label class="form-label" for="platform-search">Search institution</label>
 <input class="form-control mb-3" id="platform-search" placeholder="Institution name or code"/>
 <div id="platform-institutions" class="row g-2" aria-live="polite"></div>
</section>
<section class="ev-card p-4 mb-3" id="platform-selected" hidden>
 <h2 class="h5" id="platform-selected-name">Institution details</h2>
 <p id="platform-selected-scope" class="text-secondary"></p>
 <div class="row g-3">
 <div class="col-lg-6"><h3 class="h6">Available modules</h3><div id="platform-modules"></div></div>
 <div class="col-lg-6"><h3 class="h6">Institution users</h3><div id="platform-users"></div></div>
 </div>
 <hr/>
 <h3 class="h6">Invite institution user</h3>
 <form id="platform-invite" class="row g-2">
  <div class="col-lg-4"><label class="form-label" for="invite-email">Email</label><input type="email" class="form-control" id="invite-email" maxlength="254" required/></div>
  <div class="col-lg-4"><label class="form-label" for="invite-name">Display name</label><input class="form-control" id="invite-name" maxlength="160" required/></div>
  <div class="col-lg-2"><label class="form-label" for="invite-role">Role</label><select class="form-select" id="invite-role"><option value="MEMBER">Member</option><option value="ADMIN">Admin</option></select></div>
  <div class="col-lg-2 d-flex align-items-end"><button class="btn btn-primary" type="submit">Invite</button></div>
 </form>
 <p class="small text-secondary mt-2">Invited users activate their accounts through the existing password-reset flow. No passwords are displayed.</p>
</section>
<section class="ev-card p-4 mb-3">
 <div class="d-flex align-items-center gap-2 justify-content-between"><div>
  <h2 class="h5">All registered system actions</h2>
  <p class="small text-secondary">System-wide API inventory. Platform-managed actions are executable here; institution actions remain tenant-authorized.</p>
  </div><button type="button" class="btn btn-outline-primary btn-sm" id="platform-load-actions">Show API actions</button></div>
 <label class="form-label" for="platform-actions-search">Filter action</label>
 <input class="form-control mb-3" id="platform-actions-search" placeholder="Module, method or route"/>
 <div id="platform-actions-count" class="small text-secondary mb-2"></div>
 <div id="platform-actions" class="overflow-auto" style="max-height:420px" aria-live="polite"></div>
</section>
<p id="platform-message" role="status"></p>
@section Scripts {<script src="~/js/platform-console.js" asp-append-version="true"></script>}
