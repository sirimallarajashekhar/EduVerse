@{ ViewData["Title"]="Library, Transport & Hostel"; }
<p class="ev-eyebrow">EduVerse · Campus operations</p>
<h1 class="h3">Library, Transport &amp; Hostel</h1>
<p class="text-secondary">Manage campus lending, routes and residential assignments. Transactions are validated by the REST API.</p>
<section class="ev-card p-4 mb-3">
 @Html.AntiForgeryToken()
 <label for="campus" class="form-label">Campus</label>
 <select id="campus" class="form-select" style="max-width:430px"></select>
 <p id="status" class="small mt-2" role="status"></p>
 <p id="summary" class="small text-secondary"></p>
</section>
<div class="row g-3 mb-3">
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Library catalog</h2>
  <form id="title-form" class="row g-2">
   <div class="col-12"><label for="title" class="form-label">Book title</label><input id="title" class="form-control" maxlength="180" required/></div>
   <div class="col-12"><label for="author" class="form-label">Author</label><input id="author" class="form-control" maxlength="160" required/></div>
   <div class="col-12"><label for="isbn" class="form-label">ISBN (optional)</label><input id="isbn" class="form-control" maxlength="20"/></div>
   <div class="col-12"><button class="btn btn-primary" type="submit">Add title</button></div>
  </form>
  <hr/>
  <h3 class="h6">Register a copy</h3>
  <form id="copy-form" class="row g-2">
   <div class="col-12"><label for="copy-title" class="form-label">Title</label><select id="copy-title" class="form-select" required></select></div>
   <div class="col-12"><label for="barcode" class="form-label">Barcode</label><input id="barcode" class="form-control" maxlength="64" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Register copy</button></div>
  </form>
 </section></div>
 <div class="col-lg-8"><section class="ev-card p-4 h-100">
  <h2 class="h5">Circulation, reservations and fines</h2>
  <form id="loan-form" class="row g-2">
   <div class="col-sm-6"><label for="loan-copy" class="form-label">Available copy</label><select id="loan-copy" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="loan-student" class="form-label">Student</label><select id="loan-student" class="form-select" required></select></div>
   <div class="col-sm-6"><label for="loan-due" class="form-label">Due date</label><input id="loan-due" type="date" class="form-control" required/></div>
   <div class="col-sm-6 d-flex align-items-end"><button class="btn btn-primary" type="submit">Lend copy</button></div>
  </form>
  <hr/>
  <form id="reservation-form" class="row g-2">
   <div class="col-sm-5"><label for="reserve-title" class="form-label">Reserve title</label><select id="reserve-title" class="form-select" required></select></div>
   <div class="col-sm-5"><label for="reserve-student" class="form-label">Student</label><select id="reserve-student" class="form-select" required></select></div>
   <div class="col-sm-2 d-flex align-items-end"><button class="btn btn-outline-primary" type="submit">Reserve</button></div>
  </form>
  <h3 class="h6 mt-3">Loans and returns</h3><ul id="loan-list" class="small"></ul>
  <h3 class="h6 mt-3">Reservations</h3><ul id="reservation-list" class="small"></ul>
  <p class="small text-secondary">Overdue fines are calculated at return (₹2 per overdue calendar day, capped at ₹500). No payment is collected here.</p>
 </section></div>
</div>
<div class="row g-3 mb-3">
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Transport vehicles &amp; drivers</h2>
  <form id="vehicle-form" class="row g-2">
   <div class="col-sm-7"><label for="registration" class="form-label">Registration</label><input id="registration" maxlength="32" class="form-control" required/></div>
   <div class="col-sm-5"><label for="capacity" class="form-label">Seats</label><input id="capacity" type="number" min="1" max="100" class="form-control" required/></div>
   <div class="col-12"><label for="driver" class="form-label">Driver</label><input id="driver" maxlength="120" class="form-control" required/></div>
   <div class="col-12"><label for="driver-phone" class="form-label">Phone (optional)</label><input id="driver-phone" maxlength="30" class="form-control"/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Add vehicle</button></div>
  </form>
 </section></div>
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Transport routes and stops</h2>
  <form id="route-form" class="row g-2">
   <div class="col-12"><label for="route-vehicle" class="form-label">Vehicle</label><select id="route-vehicle" class="form-select" required></select></div>
   <div class="col-sm-5"><label for="route-code" class="form-label">Route code</label><input id="route-code" maxlength="30" class="form-control" required/></div>
   <div class="col-sm-7"><label for="route-name" class="form-label">Route name</label><input id="route-name" maxlength="120" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Create route</button></div>
  </form>
  <hr/>
  <form id="stop-form" class="row g-2">
   <div class="col-12"><label for="stop-route" class="form-label">Route</label><select id="stop-route" class="form-select" required></select></div>
   <div class="col-sm-8"><label for="stop-name" class="form-label">Stop name</label><input id="stop-name" maxlength="120" class="form-control" required/></div>
   <div class="col-sm-4"><label for="stop-order" class="form-label">Sequence</label><input id="stop-order" type="number" min="1" max="500" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Add stop</button></div>
  </form>
 </section></div>
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Student transport assignments</h2>
  <form id="route-assignment-form" class="row g-2">
   <div class="col-12"><label for="assign-student" class="form-label">Student</label><select id="assign-student" class="form-select" required></select></div>
   <div class="col-12"><label for="assign-route" class="form-label">Route</label><select id="assign-route" class="form-select" required></select></div>
   <div class="col-12"><label for="assign-stop" class="form-label">Pickup stop</label><select id="assign-stop" class="form-select" required></select></div>
   <div class="col-12"><button class="btn btn-primary" type="submit">Assign route</button></div>
  </form>
  <ul id="route-assignments" class="small mt-3"></ul>
 </section></div>
</div>
<div class="row g-3">
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Hostel blocks &amp; rooms</h2>
  <form id="block-form" class="row g-2">
   <div class="col-sm-5"><label for="block-code" class="form-label">Block code</label><input id="block-code" maxlength="30" class="form-control" required/></div>
   <div class="col-sm-7"><label for="block-name" class="form-label">Name</label><input id="block-name" maxlength="120" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Create block</button></div>
  </form>
  <hr/>
  <form id="room-form" class="row g-2">
   <div class="col-12"><label for="room-block" class="form-label">Block</label><select id="room-block" class="form-select" required></select></div>
   <div class="col-12"><label for="room-number" class="form-label">Room number</label><input id="room-number" maxlength="30" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Add room</button></div>
  </form>
 </section></div>
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Beds and occupancy</h2>
  <form id="bed-form" class="row g-2">
   <div class="col-12"><label for="bed-room" class="form-label">Room</label><select id="bed-room" class="form-select" required></select></div>
   <div class="col-12"><label for="bed-number" class="form-label">Bed number</label><input id="bed-number" maxlength="30" class="form-control" required/></div>
   <div class="col-12"><button class="btn btn-outline-primary" type="submit">Create bed</button></div>
  </form>
  <h3 class="h6 mt-3">Bed inventory</h3><ul id="beds-list" class="small"></ul>
 </section></div>
 <div class="col-lg-4"><section class="ev-card p-4 h-100">
  <h2 class="h5">Student bed allocations</h2>
  <form id="hostel-allocation-form" class="row g-2">
   <div class="col-12"><label for="hostel-student" class="form-label">Student</label><select id="hostel-student" class="form-select" required></select></div>
   <div class="col-12"><label for="hostel-bed" class="form-label">Available bed</label><select id="hostel-bed" class="form-select" required></select></div>
   <div class="col-12"><button class="btn btn-primary" type="submit">Allocate bed</button></div>
  </form>
  <ul id="hostel-allocations" class="small mt-3"></ul>
  <p class="small text-secondary">Vacate the existing bed before transferring a student to another bed.</p>
 </section></div>
</div>
@section Scripts {<script src="~/js/operations-admin.js" asp-append-version="true"></script>}
