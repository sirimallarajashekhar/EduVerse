@model EduVerse.Web.Models.ResetRequestForm
@{ ViewData["Title"] = "Reset password"; }
<section class="ev-card p-4 mx-auto" style="max-width:440px">
  <h1 class="h3">Reset password</h1>
  @if (TempData["Info"] is string message) { <p role="status">@message</p> }
  <form method="post" asp-action="PasswordReset">
    @Html.AntiForgeryToken()
    <label asp-for="Email" class="form-label">Account email</label>
    <input asp-for="Email" type="email" class="form-control mb-3" required autocomplete="email" />
    <button class="btn btn-primary" type="submit">Request reset link</button>
  </form>
</section>
