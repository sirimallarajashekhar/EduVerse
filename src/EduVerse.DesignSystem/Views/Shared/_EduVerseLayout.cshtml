<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · EduVerse ERP</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/_content/EduVerse.DesignSystem/css/eduverse.css" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <div class="d-flex min-vh-100">
    <aside class="ev-sidebar p-3" aria-label="Main navigation">
      <a class="ev-brand d-block mb-4" href="/">EduVerse <span>ERP</span></a>
      <div class="ev-nav-label mb-2">PLATFORM</div>
      <nav aria-label="Modules">
        <a class="ev-nav-item" href="/">Dashboard</a>
        @if (User.IsInRole("PLATFORM_SUPER_ADMIN"))
        {
          <a class="ev-nav-item" href="/platform/registrations">School Approvals</a>
        }
        @if (User.IsInRole("ADMIN"))
        {
          <div id="tenant-module-navigation" role="group" aria-label="Institution modules">
            <span class="text-white-50 small">Loading institution modules…</span>
          </div>
        }
                <div id="module-navigation" role="group" aria-label="Installed modules">
          <span class="text-white-50 small">Loading modules…</span>
        </div>
      </nav>
      <div class="ev-sidebar-footer">School &amp; College Platform</div>
    </aside>
    <div class="flex-grow-1 ev-page">
      <header class="ev-topbar d-flex align-items-center justify-content-between px-4 py-3">
        <span class="fw-semibold">@ViewData["Title"]</span>
        @if (User.Identity?.IsAuthenticated == true)
        {
          <div class="d-flex align-items-center gap-3">
            <span class="small text-secondary">@User.Identity.Name</span>
            <form method="post" action="@(User.IsInRole("PLATFORM_SUPER_ADMIN") ? "/platform/logout" : "/account/logout")" class="mb-0">
              @Html.AntiForgeryToken()
              <button class="btn btn-sm btn-outline-secondary" type="submit">Sign out</button>
            </form>
          </div>
        }
        else
        {
          <div class="d-flex gap-2"><a href="/register-institution" class="btn btn-sm btn-outline-primary">Register school</a><a href="/account/login" class="btn btn-sm btn-primary">Sign in</a></div>
        }
      </header>
      <main class="container-fluid px-4 py-4">@RenderBody()</main>
    </div>
  </div>
  <script src="/_content/EduVerse.DesignSystem/js/navigation.js" defer></script>
  <script src="/_content/EduVerse.DesignSystem/js/tenant-navigation.js" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
