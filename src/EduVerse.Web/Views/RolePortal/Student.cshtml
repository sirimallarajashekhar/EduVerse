@{ViewData["Title"]="Student portal";}
@{ ViewData["Title"] = ViewData["ActivityTitle"]; }
<div class="ev-module-workspace" data-activity-page="true" data-activity-base="/portal/student">
<header class="mb-4"><p class="ev-eyebrow">EduVerse · Student</p><h1 class="h2">@ViewData["ActivityTitle"]</h1>
<p class="text-secondary">Timetable, daily attendance, assignments and published results for your own linked student profile.</p></header><p><a class="ev-module-home" href="/portal/student">← All student activities</a></p>

@Html.AntiForgeryToken()
<section class="ev-card p-3 mb-3" ev-activities="phase23-student-submit,p23-load-work"><label class="form-label" for="p23-campus">Campus ID</label><input form="phase23-student-submit" class="form-control mb-2" id="p23-campus" required/></section><section class="ev-card p-3 mb-3" ev-activities="phase23-student-submit,p23-load-work"><label class="form-label" for="p23-student">Your linked student ID</label><input form="phase23-student-submit" class="form-control mb-2" id="p23-student" required/></section>
<div class="ev-card p-4 mb-3"><label for="links" class="form-label">Choose student</label><select id="links" class="form-select"></select></div>
<div ev-activities="timetable,attendance,results,assignments,notices" class="row g-3">
<div ev-activities="timetable" class="col-lg-6"><section ev-activities="timetable" class="ev-card p-4"><div ev-activities="timetable" data-ev-action="View Timetable" data-ev-action-key="timetable" id="timetable"></div></section></div>
<div ev-activities="attendance" class="col-lg-6"><section ev-activities="attendance" class="ev-card p-4"><div ev-activities="attendance" data-ev-action="View Attendance" data-ev-action-key="attendance" id="attendance"></div></section></div>
<div ev-activities="results" class="col-lg-6"><section ev-activities="results" class="ev-card p-4"><div ev-activities="results" data-ev-action="View Published results" data-ev-action-key="results" id="results"></div></section></div>
<div ev-activities="assignments" class="col-lg-6"><section ev-activities="assignments" class="ev-card p-4"><div ev-activities="assignments" data-ev-action="View Assignments" data-ev-action-key="assignments" id="assignments"></div></section></div>
<div ev-activities="notices" class="col-12"><section ev-activities="notices" class="ev-card p-4"><div ev-activities="notices" data-ev-action="View Announcements" data-ev-action-key="notices" id="notices"></div></section></div>
</div><p id="portal-message" role="status" class="mt-3"></p>

@section Scripts {<script src="~/js/role-portals.js" asp-append-version="true"></script>}

<form id="p23-anti">@Html.AntiForgeryToken()</form>
<section ev-activities="phase23-student-submit,p23-load-work" class="ev-card p-4 my-3">
<form ev-activities="phase23-student-submit" data-ev-action="Submit work" data-ev-action-key="phase23-student-submit" id="phase23-student-submit">


<label class="form-label" for="p23-assignment">Published assignment UUID</label><input class="form-control mb-2" id="p23-assignment" required/>
<label class="form-label" for="p23-response">Your response</label><textarea class="form-control mb-2" id="p23-response" maxlength="8000" required></textarea>
<button class="btn btn-primary" type="submit">Submit work</button></form>
<button ev-activities="p23-load-work" data-ev-action="View my submissions" data-ev-action-key="p23-load-work" class="btn btn-outline-secondary btn-sm mt-3" id="p23-load-work">View my submissions</button>
<div ev-activities="p23-load-work" data-ev-action="View my submissions" data-ev-action-key="p23-load-work" id="p23-work"></div></section><p id="p23-status" role="status"></p>
<script defer src="/js/phase23-portals.js"></script>

</div>
