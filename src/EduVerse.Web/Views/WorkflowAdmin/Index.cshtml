@{ ViewData["Title"] = "Cross-Module Workflows"; }
@{ ViewData["Title"] = ViewData["ActivityTitle"]; }
<div class="ev-module-workspace" data-activity-page="true" data-activity-base="/admin/workflows">
<p class="ev-eyebrow">EduVerse · Administration</p>
<h1 class="h2">@ViewData["ActivityTitle"]</h1><p><a class="ev-module-home" href="/admin/workflows">← All institution workflows</a></p>

@Html.AntiForgeryToken()
<section class="ev-card p-3 mb-3" ev-activities="clearance-form,exit-button"><label class="form-label" for="exit-employee">Employee ID</label><input form="clearance-form" class="form-control mb-2" id="exit-employee" required /></section>
<p class="text-secondary">Link employee identities, verify exit asset clearance, and submit ordered purchases for finance review. Actions are validated by the tenant-secured API.</p>
<section class="ev-card p-4 mb-3">
    @Html.AntiForgeryToken()
    <label class="form-label" for="campus">Campus ID</label>
    <input class="form-control" id="campus" type="text" placeholder="Campus UUID" autocomplete="off" required />
    <p class="small mt-2" id="workflow-status" role="status" aria-live="polite"></p>
</section>
<div ev-activities="binding-form,clearance-form,exit-button,purchase-form" class="row g-3">
    <div ev-activities="binding-form" class="col-lg-6">
        <section ev-activities="binding-form" class="ev-card p-4 h-100">

            <form ev-activities="binding-form" data-ev-action="Link identity and campus access" data-ev-action-key="binding-form" id="binding-form">
                <label class="form-label" for="binding-employee">Employee ID</label>
                <input class="form-control mb-2" id="binding-employee" required />
                <label class="form-label" for="binding-user">Existing Identity User ID</label>
                <input class="form-control mb-3" id="binding-user" required />
                <button class="btn btn-primary" type="submit">Link identity and campus access</button>
            </form>
        </section>
    </div>
    <div ev-activities="clearance-form,exit-button" class="col-lg-6">
        <section ev-activities="clearance-form,exit-button" class="ev-card p-4 h-100">

            <form ev-activities="clearance-form" data-ev-action="Check asset clearance" data-ev-action-key="clearance-form" id="clearance-form">


                <button class="btn btn-outline-primary mb-3" type="submit">Check asset clearance</button>
            </form>
            <p class="small" id="clearance-result" role="status"></p>
            <button ev-activities="exit-button" data-ev-action="Confirm offboarding" data-ev-action-key="exit-button" id="exit-button" class="btn btn-danger" type="button" disabled>Confirm offboarding</button>
        </section>
    </div>
    <div ev-activities="purchase-form" class="col-12">
        <section ev-activities="purchase-form" class="ev-card p-4">

            <p class="small text-secondary">Records a pending finance handoff; does not post the general ledger.</p>
            <form ev-activities="purchase-form" data-ev-action="Submit to finance review" data-ev-action-key="purchase-form" id="purchase-form">
                <label for="purchase-id" class="form-label">Ordered purchase ID</label>
                <input id="purchase-id" class="form-control mb-3" required />
                <button type="submit" class="btn btn-primary">Submit to finance review</button>
            </form>
        </section>
    </div>
</div>

@section Scripts { <script src="~/js/workflow-admin.js" asp-append-version="true"></script> }

</div>
