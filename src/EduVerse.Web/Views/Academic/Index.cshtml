@{ViewData["Title"]="Academic Management";}
<div class="mb-4">
  <p class="ev-eyebrow">School &amp; college academics</p>
  <h1 class="h3">Academic administration</h1>
  <p class="text-secondary">Academic structures and faculty allocations are managed by tenant-secured REST APIs.</p>
</div>
<section class="ev-card p-4 mb-3">
  @Html.AntiForgeryToken()
  <label class="form-label" for="academic-campus">Active campus</label>
  <select id="academic-campus" class="form-select" style="max-width:480px" aria-label="Academic campus"></select>
  <p id="academic-message" class="mt-3 small" role="status" aria-live="polite">Loading campuses…</p>
</section>
<div class="row g-3 mb-3">
  <div class="col-lg-4">
    <section class="ev-card p-4 h-100">
      <h2 class="h5">Academic year</h2>
      <form id="year-form">
        <label class="form-label" for="year-code">Code</label><input id="year-code" class="form-control mb-2" required maxlength="30" placeholder="2026-27" />
        <label class="form-label" for="year-name">Name</label><input id="year-name" class="form-control mb-2" required maxlength="160" placeholder="Academic Year 2026–27" />
        <label class="form-label" for="year-start">Start date</label><input id="year-start" type="date" class="form-control mb-2" required />
        <label class="form-label" for="year-end">End date</label><input id="year-end" type="date" class="form-control mb-3" required />
        <button class="btn btn-primary" type="submit">Add academic year</button>
      </form>
    </section>
  </div>
  <div class="col-lg-8">
    <section class="ev-card p-4 h-100">
      <h2 class="h5">Academic catalog</h2>
      <p class="text-secondary small">Manage terms, semesters, grades, classes, sections, programs, courses, batches and subjects.</p>
      <form id="catalog-form" class="row g-2">
        <div class="col-sm-4"><label class="form-label" for="item-kind">Type</label>
          <select id="item-kind" class="form-select">
            <option>PROGRAM</option><option>GRADE</option><option>CLASS</option><option>SECTION</option>
            <option>COURSE</option><option>BATCH</option><option>SUBJECT</option><option>TERM</option><option>SEMESTER</option>
          </select></div>
        <div class="col-sm-4"><label class="form-label" for="item-code">Code</label><input id="item-code" class="form-control" required maxlength="30" /></div>
        <div class="col-sm-4"><label class="form-label" for="item-name">Name</label><input id="item-name" class="form-control" required maxlength="160" /></div>
        <div class="col-sm-6"><label class="form-label" for="item-parent">Parent academic item (optional)</label>
          <select id="item-parent" class="form-select"><option value="">None</option></select></div>
        <div class="col-sm-6"><label class="form-label" for="item-year">Academic year (optional)</label>
          <select id="item-year" class="form-select"><option value="">None</option></select></div>
        <div class="col-sm-6"><label class="form-label" for="item-department">Department (optional)</label>
          <select id="item-department" class="form-select"><option value="">None</option></select></div>
        <div class="col-sm-3"><label class="form-label" for="item-start">Start (optional)</label><input id="item-start" type="date" class="form-control" /></div>
        <div class="col-sm-3"><label class="form-label" for="item-end">End (optional)</label><input id="item-end" type="date" class="form-control" /></div>
        <div class="col-12"><button class="btn btn-primary" type="submit">Add catalog item</button></div>
      </form>
    </section>
  </div>
</div>
<div class="row g-3">
  <div class="col-lg-6">
    <section class="ev-card p-4">
      <h2 class="h5">Faculty assignment</h2>
      <form id="faculty-form" class="row g-2">
        <div class="col-sm-6"><label class="form-label" for="faculty-subject">Subject</label><select id="faculty-subject" class="form-select" required></select></div>
        <div class="col-sm-6"><label class="form-label" for="faculty-year">Academic year</label><select id="faculty-year" class="form-select" required></select></div>
        <div class="col-sm-12"><label class="form-label" for="faculty-person">Registered faculty/member</label><select id="faculty-person" class="form-select" required></select></div>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">Assign faculty</button></div>
      </form>
    </section>
  </div>
  <div class="col-lg-6">
    <section class="ev-card p-4">
      <h2 class="h5">Academic calendar</h2>
      <form id="calendar-form" class="row g-2">
        <div class="col-sm-6"><label for="event-kind" class="form-label">Event type</label>
          <select id="event-kind" class="form-select"><option>HOLIDAY</option><option>EVENT</option><option>EXAM</option><option>ACADEMIC</option></select></div>
        <div class="col-sm-6"><label for="event-year" class="form-label">Academic year</label><select id="event-year" class="form-select" required></select></div>
        <div class="col-12"><label for="event-title" class="form-label">Title</label><input id="event-title" class="form-control" required maxlength="160" /></div>
        <div class="col-sm-6"><label for="event-start" class="form-label">Start</label><input id="event-start" type="date" class="form-control" required /></div>
        <div class="col-sm-6"><label for="event-end" class="form-label">End</label><input id="event-end" type="date" class="form-control" required /></div>
        <div class="col-12"><button class="btn btn-outline-primary" type="submit">Add calendar event</button></div>
      </form>
    </section>
  </div>
  <div class="col-12">
    <section class="ev-card p-4">
      <h2 class="h5">Academic overview</h2>
      <p id="academic-overview" class="text-secondary small"></p>
      <div class="row g-3">
        <div class="col-md-4"><h3 class="h6">Years</h3><ul id="academic-years"></ul></div>
        <div class="col-md-4"><h3 class="h6">Catalog</h3><ul id="academic-items"></ul></div>
        <div class="col-md-4"><h3 class="h6">Holidays &amp; events</h3><ul id="academic-events"></ul></div>
      </div>
    </section>
  </div>
</div>
@section Scripts {<script src="~/js/academic-admin.js" asp-append-version="true"></script>}
