<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EduVerse ERP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <link href="~/css/site.css" rel="stylesheet" asp-append-version="true" />
</head>
<body>
  <header class="bg-dark text-white py-3"><div class="container"><strong>EduVerse ERP</strong> <span class="ms-2 text-white-50">Foundation Portal</span></div></header>
  <main class="container py-5">@RenderBody()</main>
  <script src="~/js/site.js" asp-append-version="true"></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
