@{ViewData["Title"]="Parent portal";}
<header class="mb-4"><p class="ev-eyebrow">EduVerse · Parent</p><h1 class="h3">My children</h1>
<p class="text-secondary">Access is limited to children linked and verified by your institution.</p></header>
<div class="ev-card p-4 mb-3"><h2 class="h5">Linked children</h2><div id="links" aria-live="polite"></div></div>
<div class="row g-3"><div class="col-lg-4"><section class="ev-card p-4"><h2 class="h5">Attendance</h2><div id="attendance"></div></section></div>
<div class="col-lg-4"><section class="ev-card p-4"><h2 class="h5">Published results</h2><div id="results"></div></section></div>
<div class="col-lg-4"><section class="ev-card p-4"><h2 class="h5">Announcements</h2><div id="notices"></div></section></div></div>
<p id="portal-message" role="status" class="mt-3"></p>
@section Scripts {<script src="~/js/role-portals.js" asp-append-version="true"></script>}
