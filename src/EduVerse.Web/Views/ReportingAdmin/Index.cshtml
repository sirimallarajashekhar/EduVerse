@{ ViewData["Title"] = "Analytics and Reports"; }
<p class="ev-eyebrow">EduVerse · Administration</p>
<h1 class="h3">Institution Analytics & Reports</h1>
<p class="text-secondary">Read-only campus analytics. Metrics and exports are calculated by tenant-secured REST APIs.</p>
<section class="ev-card p-4 mb-3">
    <form id="report-filter" class="row g-3">
        <div class="col-md-5"><label for="campus" class="form-label">Campus</label><select id="campus" class="form-select" required></select></div>
        <div class="col-md-3"><label for="from" class="form-label">From (UTC)</label><input id="from" class="form-control" type="date" required /></div>
        <div class="col-md-3"><label for="to" class="form-label">To (UTC)</label><input id="to" class="form-control" type="date" required /></div>
        <div class="col-md-1 d-flex align-items-end"><button class="btn btn-primary" type="submit">Run</button></div>
    </form>
    <p id="status" role="status" aria-live="polite" class="small mt-3"></p>
</section>
<section class="ev-card p-4 mb-3">
    <h2 class="h5">Campus at a glance</h2>
    <dl id="kpis" class="row"></dl>
    <p class="small text-secondary">People and asset counts are current; financial amounts reflect recorded activity through the selected end date (UTC).</p>
</section>
<section class="ev-card p-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="h5 mb-0">Monthly enrollment and collections</h2>
        <div class="d-flex gap-2">
            <a id="download" class="btn btn-outline-primary disabled" href="#" aria-disabled="true">CSV</a>
            <a id="download-xlsx" class="btn btn-outline-primary disabled" href="#" aria-disabled="true">Excel</a>
            <a id="download-pdf" class="btn btn-outline-primary disabled" href="#" aria-disabled="true">PDF</a>
        </div>
    </div>
    <div class="table-responsive"><table class="table table-striped">
      <caption>Monthly campus reporting totals, UTC</caption>
      <thead><tr><th scope="col">Month</th><th scope="col">Enrollments</th><th scope="col">Payments</th><th scope="col">Collected (INR)</th></tr></thead>
      <tbody id="report-rows"></tbody>
    </table></div>
</section>
@section Scripts { <script src="~/js/reporting-admin.js" asp-append-version="true"></script> }
