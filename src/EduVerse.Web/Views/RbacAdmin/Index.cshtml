@{ViewData["Title"]="Roles and permissions";}
<div class="ev-module-workspace">
<div class="mb-4">
  <p class="ev-eyebrow">Institution security</p>
  <h1 class="h3">Roles &amp; Permissions</h1>
  <p class="text-secondary">Tenant-owned custom roles. Platform Super Admin and institution ADMIN are protected system roles.</p>
</div>
<form id="rbac-token-form">@Html.AntiForgeryToken()</form>
<div class="row g-3">
 <div class="col-lg-5">
  <section class="ev-card p-4 mb-3">
   <h2 class="h5">Create role</h2>
   <form id="rbac-create">
    <label for="rbac-code" class="form-label">Code (uppercase)</label>
    <input id="rbac-code" class="form-control mb-2" required maxlength="32" pattern="[A-Z][A-Z0-9_]{2,31}" placeholder="TEACHER"/>
    <label for="rbac-name" class="form-label">Display name</label>
    <input id="rbac-name" class="form-control mb-2" maxlength="100" required placeholder="Teacher"/>
    <button type="submit" class="btn btn-primary">Create role</button>
   </form>
  </section>
  <section class="ev-card p-4">
   <h2 class="h5">Assign or revoke role</h2>
   <form id="rbac-assign">
    <label for="rbac-user" class="form-label">Institution member</label>
    <select id="rbac-user" required class="form-select mb-2"></select>
    <label for="rbac-assign-role" class="form-label">Custom role</label>
    <select id="rbac-assign-role" required class="form-select mb-2"></select>
    <button type="submit" class="btn btn-primary">Assign role</button>
   </form>
   <h3 class="h6 mt-4">Current assignments</h3>
   <div id="rbac-assignments" aria-live="polite"></div>
  </section>
 </div>
 <div class="col-lg-7">
  <section class="ev-card p-4">
   <h2 class="h5">Role permission editor</h2>
   <label for="rbac-edit-role" class="form-label">Role</label>
   <select id="rbac-edit-role" class="form-select mb-3"></select>
   <form id="rbac-permissions">
    <div id="rbac-permission-options" class="row g-2 mb-3"></div>
    <button type="submit" class="btn btn-primary">Save permissions</button>
   </form>
   <p class="text-secondary small mt-3">Changing permissions revokes affected sessions. Users sign in again for changes to take effect.</p>
  </section>
 </div>
</div>
<p id="rbac-feedback" role="status" class="mt-3"></p>

</div>
@section Scripts {<script src="~/js/rbac-admin.js" asp-append-version="true"></script>}
