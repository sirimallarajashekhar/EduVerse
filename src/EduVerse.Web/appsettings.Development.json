{
  "Api": { "BaseUrl": "https://localhost:7201/" },

  "BackgroundJobs": {
    "OutboxEnabled": true
  },

  "ReverseProxy": {
    "Routes": {
      "ams-root": {
        "ClusterId": "ams",
        "Match": { "Path": "/ams" }
      },
      "ams-pages": {
        "ClusterId": "ams",
        "Match": { "Path": "/ams/{**remainder}" }
      },
      "hrms-root": {
        "ClusterId": "hrms",
        "Match": { "Path": "/hrms" }
      },
      "hrms-pages": {
        "ClusterId": "hrms",
        "Match": { "Path": "/hrms/{**remainder}" }
      }
    },
    "Clusters": {
      "ams": { "Destinations": { "primary": { "Address": "http://localhost:5202/" } } },
      "hrms": { "Destinations": { "primary": { "Address": "http://localhost:5203/" } } },
      "eduverse-api": {
        "Destinations": {
          "api": {
            "Address": "https://localhost:7201/"
          }
        }
      }
    },
    "Logging": {
      "LogLevel": {
        "Default": "Information",
        "Microsoft.AspNetCore": "Warning"
      }
    },
    "ConnectionStrings": {
      "EduVerse": "server=localhost;uid=root;pwd=Synaptic@123;Max Pool Size=20000;Database=eduverse;AllowLoadLocalInfile=true"
    },
    "AllowedHosts": "*"
  }
}
  
