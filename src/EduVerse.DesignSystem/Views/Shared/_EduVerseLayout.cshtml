<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@ViewData["Title"] · EduVerse ERP</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="/_content/EduVerse.DesignSystem/css/eduverse.css" />
  @await RenderSectionAsync("Styles", required: false)
</head>
<body>
  <div class="d-flex min-vh-100">
    <aside class="ev-sidebar p-3" aria-label="Main navigation">
      <a class="ev-brand d-block mb-4" href="/">EduVerse <span>ERP</span></a>
      <div class="ev-nav-label mb-2">PLATFORM</div>
      <nav aria-label="Modules">
        <a class="ev-nav-item" href="/">Dashboard</a>
        <div id="module-navigation" role="group" aria-label="Installed modules">
          <span class="text-white-50 small">Loading modules…</span>
        </div>
      </nav>
      <div class="ev-sidebar-footer">School &amp; College Platform<br /><small>Phase 2 preview · No login yet</small></div>
    </aside>
    <div class="flex-grow-1 ev-page">
      <header class="ev-topbar d-flex align-items-center justify-content-between px-4 py-3">
        <span class="fw-semibold">@ViewData["Title"]</span>
        <span class="badge text-bg-light">Demo shell</span>
      </header>
      <main class="container-fluid px-4 py-4">@RenderBody()</main>
    </div>
  </div>
  <script src="/_content/EduVerse.DesignSystem/js/navigation.js" defer></script>
  @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
