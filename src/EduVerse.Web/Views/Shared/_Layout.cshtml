@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var platformAdmin = User.IsInRole("PLATFORM_SUPER_ADMIN");
    var institutionAdmin = User.IsInRole("ADMIN");
    var landing = platformAdmin ? "/platform/console" : "/modules";
    var roleLabel = platformAdmin ? "Platform Super Admin" : institutionAdmin ? "Institution Administrator" : "Institution Member";
    var currentPath = Context.Request.Path.Value ?? "/";
}
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>@(ViewData["Title"] ?? "EduVerse") · EduVerse ERP</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" crossorigin="anonymous" />
  <link href="/_content/EduVerse.DesignSystem/css/eduverse.css" rel="stylesheet" />
  <link href="~/css/reporting.css" rel="stylesheet" asp-append-version="true" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="@(authenticated ? "ev-app-shell" : "ev-public-shell")">
  <a class="ev-skip-link" href="#main-content">Skip to main content</a>
  @if(authenticated)
  {
    <div class="ev-workspace">
      <div id="ev-nav-backdrop" class="ev-nav-backdrop" hidden></div>
      <aside class="ev-workspace-sidebar" id="ev-sidebar" aria-label="Primary workspace navigation">
        <div class="ev-sidebar-brand">
          <a href="@landing" class="ev-sidebar-brand-link" aria-label="EduVerse dashboard">
            <span class="ev-brand-emblem" aria-hidden="true">E</span>
            <span>Edu<span class="ev-brand-accent">Verse</span><small>EDUCATION ERP</small></span>
          </a>
          <button type="button" class="ev-sidebar-close" id="ev-nav-close" aria-label="Close navigation">×</button>
        </div>
        <nav class="ev-sidebar-nav" aria-label="Main navigation">
          <div class="ev-nav-label">WORKSPACE</div>
          <a href="@landing" class="ev-nav-item" aria-current="@(currentPath == landing ? "page" : null)">
            <span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><rect width="7" height="7" x="3" y="3" rx="1"/><rect width="7" height="7" x="14" y="3" rx="1"/><rect width="7" height="7" x="14" y="14" rx="1"/><rect width="7" height="7" x="3" y="14" rx="1"/></svg></span><span>Dashboard</span>
          </a>
          @if(platformAdmin)
          {
            <div class="ev-nav-label">PLATFORM</div>
            <a href="/platform/console#platform-institutions-section" class="ev-nav-item">
              <span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="M4 22V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18Z"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></svg></span><span>Institutions</span>
            </a>
            <a href="/platform/registrations" class="ev-nav-item" aria-current="@(currentPath.StartsWith("/platform/registrations",StringComparison.OrdinalIgnoreCase) ? "page" : null)">
              <span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="m9 12 2 2 4-4"/><path d="M20 13c0 5-8 9-8 9s-8-4-8-9V5l8-3 8 3z"/></svg></span><span>Institution approvals</span>
            </a>
            <a href="/platform/console#platform-modules-section" class="ev-nav-item">
              <span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span>Module catalog</span>
            </a>
            <a href="/platform/console#platform-actions-section" class="ev-nav-item">
              <span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="m16 18 6-6-6-6M8 6l-6 6 6 6m6-14-4 16"/></svg></span><span>API actions</span>
            </a>
          }
          else if(institutionAdmin)
          {
            <div class="ev-nav-label">INSTITUTION</div>
            <div id="tenant-module-navigation" class="ev-module-nav" aria-live="polite">
              <span class="ev-sidebar-hint">Loading permitted modules…</span>
            </div>
            <div class="ev-nav-label">INSIGHTS</div>
            <a href="/admin/reports" class="ev-nav-item" aria-current="@(currentPath.StartsWith("/admin/reports",StringComparison.OrdinalIgnoreCase) ? "page" : null)"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="M3 3v18h18M9 17V9M14 17V5M19 17v-6"/></svg></span><span>Reports &amp; Analytics</span></a>
            <div class="ev-nav-label">ADMINISTRATION</div>
            <a href="/admin/rbac" class="ev-nav-item"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2m20 0v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75"/><circle cx="9" cy="7" r="4"/></svg></span><span>Roles &amp; permissions</span></a>
            <a href="/portal/learning-review" class="ev-nav-item"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="m9 12 2 2 4-4"/><path d="M20 13c0 5-8 9-8 9s-8-4-8-9V5l8-3 8 3z"/></svg></span><span>Learning approvals</span></a>
          }
          else
          {
            <div class="ev-nav-label">MY PORTALS</div>
            <a href="/portal/teacher" class="ev-nav-item"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="M4 22V4a2 2 0 0 1 2-2h12a2 2 0 0 1 2 2v18Z"/><path d="M9 22v-4h6v4M8 6h.01M16 6h.01M12 6h.01M12 10h.01M12 14h.01M16 10h.01M16 14h.01M8 10h.01M8 14h.01"/></svg></span><span>Teacher workspace</span></a>
            <a href="/portal/parent" class="ev-nav-item"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78L12 21l8.84-8.61a5.5 5.5 0 0 0 0-7.78z"/></svg></span><span>Parent workspace</span></a>
            <a href="/portal/student" class="ev-nav-item"><span class="ev-nav-icon" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide" aria-hidden="true"><rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/></svg></span><span>Student workspace</span></a>
          }
        </nav>
        <div class="ev-sidebar-footer"><span class="ev-sidebar-status" aria-hidden="true"></span>EduVerse · Secure workspace</div>
      </aside>
      <div class="ev-workspace-body">
        <header class="ev-workspace-topbar">
          <div class="ev-topbar-leading">
            <button type="button" class="ev-mobile-nav-toggle" id="ev-nav-toggle" aria-label="Open navigation" aria-controls="ev-sidebar" aria-expanded="false">☰</button>
            <div class="ev-page-context">
              <span class="ev-context-eyebrow">EduVerse / @(platformAdmin ? "Platform" : "Institution")</span>
              <strong>@(ViewData["Title"] ?? "Dashboard")</strong>
            </div>
          </div>
          <div class="ev-topbar-actions">
            <span class="ev-role-chip">@roleLabel</span>
            <span class="ev-user-avatar" aria-hidden="true">@(string.IsNullOrEmpty(User.Identity?.Name) ? "U" : User.Identity!.Name![0].ToString().ToUpperInvariant())</span>
            <div class="ev-user-label"><strong>@User.Identity?.Name</strong><small>@roleLabel</small></div>
            <form method="post" action="@(platformAdmin ? "/platform/logout" : "/account/logout")" class="m-0">
              @Html.AntiForgeryToken()
              <button class="ev-signout-button" type="submit">Sign out</button>
            </form>
          </div>
        </header>
        <main id="main-content" class="ev-workspace-content" tabindex="-1">
          @RenderBody()
        </main>
      </div>
    </div>
  }
  else
  {
    <header class="ev-public-topbar">
      <a class="ev-public-brand" href="/">EduVerse ERP</a>
      <nav aria-label="Sign in options" class="d-flex flex-wrap gap-2">
        <a href="/account/login" class="btn btn-outline-secondary btn-sm">Institution login</a>
        <a href="/platform/login" class="btn btn-primary btn-sm">Super Admin login</a>
      </nav>
    </header>
    <main id="main-content" class="container py-5" tabindex="-1">
      @RenderBody()
    </main>
  }
  <script src="~/js/site.js" asp-append-version="true"></script>
  @if(authenticated)
  {
    <script src="/_content/EduVerse.DesignSystem/js/workspace-shell.js"></script>
  }
  @if(institutionAdmin && authenticated)
  {
    <script src="/_content/EduVerse.DesignSystem/js/tenant-navigation.js"></script>
  }
  @await RenderSectionAsync("Scripts", required: false)
  <script src="/_content/EduVerse.DesignSystem/js/operational-workspace.js" defer></script>
</body>
</html>
